#!/bin/bash
# Slides-Grab Studio launcher.
#
# 두 가지 모드:
#  (1) PRODUCTION — Resources/{node-arm64, app, playwright-browsers} 가 모두 있을 때.
#      번들된 Node + standalone build + Chromium 사용. 사용자 환경에 의존 X.
#  (2) DEV FALLBACK — Resources 가 비어있을 때 (= git clone 한 개발자 환경).
#      .app 의 부모 폴더 의 start.command 를 Terminal 에 띄움 (기존 dev 흐름).

set -e

APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"      # .../Slides-Grab Studio.app
PARENT_DIR="$(dirname "$APP_BUNDLE")"                  # .../bitreespark_II (개발자 환경)
RESOURCES="$APP_BUNDLE/Contents/Resources"

# ── PRODUCTION 모드 검사 ───────────────────────────────
if [ -f "$RESOURCES/app/server.js" ]; then
  # Architecture 별 Node binary 선택
  ARCH=$(uname -m)
  case "$ARCH" in
    arm64)
      NODE_BIN="$RESOURCES/node-arm64/bin"
      ;;
    x86_64)
      if [ -d "$RESOURCES/node-x64" ]; then
        NODE_BIN="$RESOURCES/node-x64/bin"
      else
        /usr/bin/osascript -e "display dialog \"이 빌드는 Apple Silicon Mac 전용이에요. Intel Mac 용 빌드를 다운로드해 주세요.\" buttons {\"확인\"} default button \"확인\" with icon caution with title \"Slides-Grab Studio\"" >/dev/null 2>&1
        exit 1
      fi
      ;;
    *)
      NODE_BIN="$RESOURCES/node-arm64/bin"
      ;;
  esac

  if [ ! -x "$NODE_BIN/node" ]; then
    /usr/bin/osascript -e "display dialog \"번들된 Node 를 찾지 못했어요. 앱을 다시 받아 주세요.\" buttons {\"확인\"} default button \"확인\" with icon caution with title \"Slides-Grab Studio\"" >/dev/null 2>&1
    exit 1
  fi

  export NODE_ENV=production
  export PATH="$NODE_BIN:$PATH"
  export PLAYWRIGHT_BROWSERS_PATH="$RESOURCES/playwright-browsers"
  export PORT=${SLIDES_GRAB_PORT:-3000}

  # 로그 위치 — macOS 표준
  LOG_DIR="$HOME/Library/Logs/Slides-Grab Studio"
  mkdir -p "$LOG_DIR"
  LOG_FILE="$LOG_DIR/server.log"

  # 모든 출력을 로그로 (사용자가 디버그 시 ~/Library/Logs/ 에서 확인)
  exec >"$LOG_FILE" 2>&1
  echo ""
  echo "[launcher] === $(date '+%Y-%m-%d %H:%M:%S') ==="
  echo "[launcher] arch=$ARCH node=$NODE_BIN/node"
  echo "[launcher] port=$PORT data=${SLIDES_GRAB_DATA_DIR:-default}"

  cd "$RESOURCES/app"

  # Server ready 감지 후 브라우저 자동 open
  (
    for i in $(seq 1 60); do
      sleep 1
      if /usr/bin/curl -s -o /dev/null -w "%{http_code}" "http://localhost:$PORT" 2>/dev/null | grep -q "^[23]"; then
        /usr/bin/open "http://localhost:$PORT"
        exit 0
      fi
    done
    # timeout — 그래도 한 번 시도
    /usr/bin/open "http://localhost:$PORT"
  ) &

  # Foreground 로 server 실행. Dock 종료 시 server 도 같이 죽음.
  exec "$NODE_BIN/node" server.js
fi

# ── DEV FALLBACK ──────────────────────────────────────
START_CMD="$PARENT_DIR/start.command"
if [ -f "$START_CMD" ]; then
  /usr/bin/open -a Terminal "$START_CMD"
  exit 0
fi

/usr/bin/osascript -e "display dialog \"실행할 수 없어요. Resources/app/server.js 또는 ../start.command 가 있어야 합니다.\" buttons {\"확인\"} default button \"확인\" with icon caution with title \"Slides-Grab Studio\"" >/dev/null 2>&1
exit 1
