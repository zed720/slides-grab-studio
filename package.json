{
  "name": "slides-grab-web-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install && pnpm exec playwright install chromium",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
